# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# See docs/setup-credentials.md for how to get these values.

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# GA4 — numeric property ID only (not "properties/123")
GA4_PROPERTY_ID=123456789

# GSC — exact URL from the Search Console property selector
GSC_SITE_URL=sc-domain:yourdomain.com

# GTM — visible in the GTM URL: accounts/ACCOUNT_ID/containers/CONTAINER_ID
GTM_ACCOUNT_ID=12345678
GTM_CONTAINER_ID=98765432
GTM_WORKSPACE_ID=   # optional — leave blank to auto-detect

# PageSpeed — optional, increases rate limits
PSI_API_KEY=

# Required for test-sheets.js only
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
